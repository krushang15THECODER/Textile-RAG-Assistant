# ==============================================================================
# Textile Intelligence RAG Platform — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# MONGODB ATLAS CONFIGURATION (Persistent Storage for Users, Sessions & Chats)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=labhtex_textile_rag

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Mandatory secret key required to register as an Administrator (role=admin)
# Application startup will fail if this is empty. Define a strong secret key.
ADMIN_REGISTRATION_KEY=<your_admin_registration_key>
SESSION_COOKIE_NAME=labhtex_session
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000

# Cookie security flag: 'false' for local HTTP development; 'true' for HTTPS production / Render
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# RETRIEVAL & RAG GUARDRAILS
# ------------------------------------------------------------------------------
# Minimum cosine similarity threshold (0.0 to 1.0). Questions below this threshold
# trigger deterministic, zero-cost abstention without invoking the LLM. Default: 0.40
RETRIEVAL_SCORE_THRESHOLD=0.40

# ------------------------------------------------------------------------------
# OPTION 1: Google Gemini API (Free tier at https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OPTION 2: OpenRouter API (Access Claude, Llama 3, DeepSeek, etc. at https://openrouter.ai/keys)
# If OPENROUTER_API_KEY is provided, it automatically routes through OpenRouter!
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-<your_openrouter_api_key>
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_PROVIDER=openrouter
