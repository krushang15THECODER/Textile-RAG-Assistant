# ==============================================================================
# Textile Intelligence RAG Platform — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Google Gemini API (Free tier at https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OPTION 2: OpenRouter API (Access Claude, Llama 3, DeepSeek, etc. at https://openrouter.ai/keys)
# If OPENROUTER_API_KEY is provided, it automatically routes through OpenRouter!
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# Administrator Portal Authentication Password (Defaults to admin123)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
