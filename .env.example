# ==============================================================================
# Textile Intelligence RAG Platform — Environment Configuration
# ==============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Administrator Portal Authentication Password (Defaults to admin123)
ADMIN_PASSWORD=admin123
