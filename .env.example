# ==============================================================================
# Textile Intelligence RAG Platform — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# MONGODB ATLAS CONFIGURATION (Persistent Storage for Users, Sessions & Chats)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=labhtex_textile_rag

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key required to register as an Administrator (role=admin)
ADMIN_REGISTRATION_KEY=LabhTexAdminSecret2026!
SESSION_COOKIE_NAME=labhtex_session
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000

# ------------------------------------------------------------------------------
# OPTION 1: Google Gemini API (Free tier at https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OPTION 2: OpenRouter API (Access Claude, Llama 3, DeepSeek, etc. at https://openrouter.ai/keys)
# If OPENROUTER_API_KEY is provided, it automatically routes through OpenRouter!
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_PROVIDER=openrouter
